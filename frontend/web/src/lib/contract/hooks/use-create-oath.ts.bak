/**
 * 创建新誓言 Hook
 * 
 * 完全模仿 contract/pumpfun_oath_contract/tests/create-oath-manual.ts 实现
 * 使用 Anchor Program 和官方推荐的方式构建和发送交易
 */

import { useMutation, useQueryClient } from '@tanstack/react-query';
import { toast } from 'sonner';
import { BN, AnchorProvider, Program } from '@coral-xyz/anchor';
import { PublicKey, SystemProgram, Connection, Commitment } from '@solana/web3.js';
import { useWalletUi, type UiWalletAccount } from '@wallet-ui/react';
import type { PumpfunOathContract } from '../pumpfun_oath_contract';
import IDL from '../pumpfun_oath_contract.json';
import type { CreateOathArgs } from '../types-v2';

// RPC Endpoint
const RPC_ENDPOINT = 'https://api.zan.top/node/v1/solana/devnet/55c625d41c924f97971cdd05bb533048';
const COMMITMENT: Commitment = 'confirmed';

// 初始化 Solana 连接
export const connection = new Connection(RPC_ENDPOINT, COMMITMENT);

/**
 * 获取 Program 实例（带类型）
 */
function getProgram(wallet: Wallet): Program<PumpfunOathContract> {
  const provider = new AnchorProvider(connection, wallet, { commitment: COMMITMENT });
  return new Program<PumpfunOathContract>(IDL as PumpfunOathContract, provider);
}

/**
 * 派生 PDA - Global State
 */
function deriveGlobalStatePDA(programId: PublicKey): PublicKey {
  const [pda] = PublicKey.findProgramAddressSync(
    [Buffer.from('global_state')],
    programId
  );
  return pda;
}

/**
 * 派生 PDA - Collateral Pool
 */
function deriveCollateralPoolPDA(programId: PublicKey): PublicKey {
  const [pda] = PublicKey.findProgramAddressSync(
    [Buffer.from('collateral_pool')],
    programId
  );
  return pda;
}

/**
 * 派生 PDA - Oath
 */
function deriveOathPDA(oathId: BN, programId: PublicKey): PublicKey {
  const [pda] = PublicKey.findProgramAddressSync(
    [Buffer.from('oath'), oathId.toArrayLike(Buffer, 'le', 8)],
    programId
  );
  return pda;
}

/**
 * 创建兼容 Anchor 的 Wallet 适配器
 */
function createAnchorWallet(account: UiWalletAccount, userPubkey: PublicKey): Wallet {
  return {
    publicKey: userPubkey,
    signTransaction: async <T extends Transaction | VersionedTransaction>(tx: T): Promise<T> => {
      console.log('[createOath] 🔑 开始签名交易...');
      
      if (!account || !('signTransaction' in account) || typeof account.signTransaction !== 'function') {
        throw new Error('当前钱包不支持 signTransaction 方法，请使用 Phantom、Backpack 等标准钱包');
      }
      
      try {
        const signedTx = await account.signTransaction(tx as any);
        console.log('[createOath] ✓ 交易签名成功');
        return signedTx as T;
      } catch (error: any) {
        console.error('[createOath] ❌ 签名失败:', error);
        throw new Error(`签名失败: ${error.message}`);
      }
    },
    signAllTransactions: async <T extends Transaction | VersionedTransaction>(txs: T[]): Promise<T[]> => {
      console.log('[createOath] 🔑 开始批量签名交易...');
      
      if (!account || !('signAllTransactions' in account) || typeof account.signAllTransactions !== 'function') {
        throw new Error('当前钱包不支持 signAllTransactions 方法');
      }
      
      try {
        const signedTxs = await account.signAllTransactions(txs as any);
        console.log('[createOath] ✓ 批量签名成功');
        return signedTxs as T[];
      } catch (error: any) {
        console.error('[createOath] ❌ 批量签名失败:', error);
        throw new Error(`批量签名失败: ${error.message}`);
      }
    },
  } as Wallet;
}
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: async (args: CreateOathArgs) => {
      // ✅ 严格检查钱包连接状态
      if (!account) {
        throw new Error('请先连接钱包');
      }

      // ✅ 验证地址有效性
      if (!account.address || account.address.length < 32) {
        throw new Error(`钱包地址无效: ${account.address}`);
      }

      console.log('[createOath] 🚀 开始创建誓言（使用 Anchor Program）...');
      console.log('[createOath] 钱包地址:', account.address);

      try {
        // Step 1: 创建 Connection
        console.log('[createOath] Step 1: 设置 Anchor Provider...');
        const connection = new Connection(RPC_ENDPOINT, 'confirmed');
        
        // Step 2: 检查余额
        console.log('[createOath] Step 2: 检查账户余额...');
        const userPubkey = new PublicKey(account.address);
        const balance = await connection.getBalance(userPubkey);
        const balanceInSol = balance / 1e9;
        console.log('[createOath] ✓ 当前余额:', balanceInSol, 'SOL');
        
        if (balance < 10_000_000) { // 0.01 SOL
          throw new Error(`余额不足，当前: ${balanceInSol.toFixed(4)} SOL，至少需要 0.01 SOL`);
        }
        
        // Step 3: 创建 Anchor Wallet 适配器（桥接 @wallet-ui/react 和 Anchor）
        console.log('[createOath] Step 3: 创建 Wallet 适配器...');
        
        // 根据 Anchor 官方文档创建兼容的 Wallet 接口
        // 参考: https://www.anchor-lang.com/docs/clients/typescript
        // Wallet 接口需要实现: publicKey, signTransaction, signAllTransactions
        const anchorWallet = {
          publicKey: userPubkey,
          signTransaction: async <T extends anchor.web3.Transaction | anchor.web3.VersionedTransaction>(
            tx: T
          ): Promise<T> => {
            console.log('[createOath] 🔑 开始签名交易...');
            
            // 检查钱包是否支持 signTransaction
            if (!account || !('signTransaction' in account) || typeof account.signTransaction !== 'function') {
              throw new Error('当前钱包不支持 signTransaction 方法，请使用 Phantom、Backpack 等标准钱包');
            }
            
            try {
              const signedTx = await account.signTransaction(tx as any);
              console.log('[createOath] ✓ 交易签名成功');
              return signedTx as T;
            } catch (error: any) {
              console.error('[createOath] ❌ 签名失败:', error);
              throw new Error(`签名失败: ${error.message}`);
            }
          },
          signAllTransactions: async <T extends anchor.web3.Transaction | anchor.web3.VersionedTransaction>(
            txs: T[]
          ): Promise<T[]> => {
            console.log('[createOath] 🔑 开始批量签名交易...');
            
            // 检查钱包是否支持 signAllTransactions
            if (!account || !('signAllTransactions' in account) || typeof account.signAllTransactions !== 'function') {
              throw new Error('当前钱包不支持 signAllTransactions 方法');
            }
            
            try {
              const signedTxs = await account.signAllTransactions(txs as any);
              console.log('[createOath] ✓ 批量签名成功');
              return signedTxs as T[];
            } catch (error: any) {
              console.error('[createOath] ❌ 批量签名失败:', error);
              throw new Error(`批量签名失败: ${error.message}`);
            }
          },
        } as anchor.Wallet;
        
        // Step 4: 创建 Anchor Provider 和 Program
        console.log('[createOath] Step 4: 创建 Anchor Program...');
        const provider = new AnchorProvider(connection, anchorWallet, {
          commitment: 'confirmed',
        });
        
        // 使用导入的 IDL 创建 Program（参考测试代码）
        const program = new Program(IDL as any, provider) as Program<PumpfunOathContract>;
        console.log('[createOath] ✓ Program ID:', program.programId.toBase58());
        
        // Step 5: 派生 PDAs（参考测试代码）
        console.log('[createOath] Step 5: 派生 PDA 账户...');
        const [globalStatePda] = await PublicKey.findProgramAddress(
          [Buffer.from('global_state')],
          program.programId
        );
        const [collateralPoolPda] = await PublicKey.findProgramAddress(
          [Buffer.from('collateral_pool')],
          program.programId
        );
        
        console.log('[createOath] ✓ Global State PDA:', globalStatePda.toBase58());
        console.log('[createOath] ✓ Collateral Pool PDA:', collateralPoolPda.toBase58());
        
        // Step 6: 获取全局状态以获取 next_oath_id（使用 Anchor 的方式）
        console.log('[createOath] Step 6: 查询全局状态获取 next_oath_id...');
        const globalState = await program.account.globalState.fetch(globalStatePda);
        const nextOathId = globalState.nextOathId;
        console.log('[createOath] ✓ Next Oath ID:', nextOathId.toString());
        console.log('[createOath] ✓ Total Oaths:', globalState.totalOaths.toString());
        console.log('[createOath] ✓ Authority:', globalState.authority.toBase58());
        
        // Step 7: 派生 oath PDA（使用 next_oath_id）
        console.log('[createOath] Step 7: 派生 Oath PDA...');
        const [oathPda] = await PublicKey.findProgramAddress(
          [Buffer.from('oath'), nextOathId.toArrayLike(Buffer, 'le', 8)],
          program.programId
        );
        console.log('[createOath] ✓ Oath PDA:', oathPda.toBase58());
        
        // Step 8: 准备创建誓言参数（使用 Anchor BN 类型）
        console.log('[createOath] Step 8: 准备创建誓言参数...');
        
        // 获取当前时间戳
        const currentTime = Math.floor(Date.now() / 1000);
        
        const createOathArgs = {
          content: args.content,
          category: args.category,
          categoryId: args.categoryId,
          startTime: new anchor.BN(args.startTime.toString()),
          endTime: new anchor.BN(args.endTime.toString()),
          stableCollateral: new anchor.BN(args.stableCollateral.toString()),
          // 写死 collateralTokens 参数（参考测试代码）
          collateralTokens: [
            {
              symbol: "USDC",
              amount: new anchor.BN(1 * 1000000), // 1 USDC (6 decimals)
              address: "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
              usdValue: new anchor.BN(1),
              lockedTime: new anchor.BN(currentTime)
            }
          ],
          isOverCollateralized: args.isOverCollateralized,
          tokenAddress: args.tokenAddress || null,
          targetApy: args.targetApy !== null && args.targetApy !== undefined 
            ? new anchor.BN(args.targetApy.toString()) 
            : null,
        };
        
        console.log('[createOath] 参数:', {
          content: createOathArgs.content,
          category: createOathArgs.category,
          categoryId: createOathArgs.categoryId,
          startTime: new Date(Number(createOathArgs.startTime) * 1000).toLocaleString(),
          endTime: new Date(Number(createOathArgs.endTime) * 1000).toLocaleString(),
          stableCollateral: createOathArgs.stableCollateral.toString(),
          collateralTokens: createOathArgs.collateralTokens.length,
          isOverCollateralized: createOathArgs.isOverCollateralized,
        });
        
        // Step 9: 使用 Anchor Program 构建指令，然后手动发送交易
        console.log('[createOath] Step 9: 构建并发送创建誓言交易...');
        console.log('[createOath] 账户信息:');
        console.log('  Global State:', globalStatePda.toBase58());
        console.log('  Oath PDA:', oathPda.toBase58());
        console.log('  Collateral Pool:', collateralPoolPda.toBase58());
        console.log('  Creator:', userPubkey.toBase58());
        console.log('  System Program:', SystemProgram.programId.toBase58());
        
        // 构建 Anchor 指令
        const instruction = await program.methods
          .createOath(createOathArgs)
          .accountsPartial({
            globalState: globalStatePda,
            oath: oathPda,
            collateralPool: collateralPoolPda,
            creator: userPubkey,
            systemProgram: SystemProgram.programId,
          })
          .instruction();
        
        console.log('[createOath] ✓ 指令构建成功');
        
        // 创建交易并添加指令
        const transaction = new Transaction().add(instruction);
        
        console.log('[createOath] ✓ 交易构建成功，准备签名并发送...');
        
        // 使用 AnchorProvider 发送并签名（官方推荐方式）
        // provider.sendAndConfirm 会自动：
        // 1. 设置 feePayer 和 recentBlockhash
        // 2. 调用 wallet.signTransaction 签名
        // 3. 发送交易并等待确认
        const signature = await provider.sendAndConfirm(transaction, [], { 
          commitment: 'confirmed',
          skipPreflight: false,
        });
        
        console.log('[createOath] ✓ 交易已确认');
        
        console.log('[createOath] ✅ 创建誓言成功！');
        console.log('[createOath] 📝 交易签名:', signature);
        console.log('[createOath] 🔗 查看交易: https://explorer.solana.com/tx/' + signature + '?cluster=devnet');
        console.log('[createOath] 🎯 Oath ID:', nextOathId.toString());
        console.log('[createOath] 📍 Oath PDA:', oathPda.toBase58());
        
        // 验证誓言创建
        console.log('[createOath] 🔍 验证誓言账户...');
        try {
          const oathAccount = await program.account.oath.fetch(oathPda);
          console.log('[createOath] ✓ Oath ID:', oathAccount.id.toString());
          console.log('[createOath] ✓ 创建者:', oathAccount.creator.toBase58());
          console.log('[createOath] ✓ 内容:', oathAccount.content);
          console.log('[createOath] ✓ 状态:', JSON.stringify(oathAccount.status));
        } catch (err) {
          console.warn('[createOath] ⚠️ 无法立即验证誓言账户（可能需要等待确认）');
        }
        
        return signature;
      } catch (error: any) {
        console.error('[createOath] ❌ 创建誓言失败:', error);
        
        // 提取更友好的错误信息
        let friendlyMessage = error?.message || '未知错误';
        if (error.logs) {
          console.error('[createOath] 程序日志:', error.logs);
          // 尝试从日志中提取错误信息
          const errorLog = error.logs.find((log: string) => log.includes('Error'));
          if (errorLog) {
            friendlyMessage = errorLog;
          }
        }
        
        throw new Error(friendlyMessage);
      }
    },
    onSuccess: (signature) => {
      toast.success(`誓言创建成功！签名: ${signature.slice(0, 8)}...`);
      queryClient.invalidateQueries({ queryKey: ['oath', 'userOaths'] });
    },
    onError: (error: Error) => {
      toast.error(`创建失败: ${error.message}`);
      console.error('[createOath] 错误详情:', error);
    },
  });
}
